PORT=4000
DATABASE_URL=postgres://postgres:password@127.0.0.1:5432/webkuis
CORS_ORIGIN=http://localhost:5173
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=admin123
ADMIN_SECONDARY_USERNAME=admin2
ADMIN_SECONDARY_PASSWORD=admin123
ADMIN_TOKEN_TTL_HOURS=8
UPLOAD_DIR=uploads
## Google Drive settings
# Root folder ID where project submissions will be stored. Required.
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# Service Account (optional). Provide either a key file path or the private key
# - Prefer using GOOGLE_SERVICE_ACCOUNT_KEY_FILE with the JSON file path.
# - Alternatively set GOOGLE_SERVICE_ACCOUNT_EMAIL and GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY
#   (private key PEM with \n for newlines). If you use this, share the root folder
#   with the service account email or use a Shared Drive that the service account can access.
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# OAuth2 (preferred if service account cannot upload to My Drive due to quota)
# These three are required to enable OAuth user flow:
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
# Optional: redirect URI used when obtaining the refresh token. Not required for server usage.
GOOGLE_OAUTH_REDIRECT_URI=

## Google Sheets export settings
# Enable automatic export/sync to Google Sheets.
GOOGLE_SHEETS_ENABLED=false

# Spreadsheet ID from the Google Sheets URL:
# https://docs.google.com/spreadsheets/d/<THIS_IS_THE_ID>/edit
GOOGLE_SHEETS_SPREADSHEET_ID=

# Notes:
# - If OAuth vars (client id/secret/refresh token) are present, the server will prefer
#   OAuth and upload using the authenticated user's Drive (uses user quota).
# - If OAuth vars are absent but service account credentials are present, the server
#   will use the service account JWT. Make sure the service account has access to the
#   `GOOGLE_DRIVE_ROOT_FOLDER_ID` (share the folder or use a Shared Drive).
# - For Sheets export, the same OAuth token must include Google Sheets scope, or the
#   spreadsheet must be shared with the service account email.
